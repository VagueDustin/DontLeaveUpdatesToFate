# Normalise to LF in the repository. Windows checkouts still get CRLF via core.autocrlf, but the
# stored blobs stay consistent, so a contributor on another platform does not see the whole tree as
# modified.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.ico binary
*.png binary
*.bmp binary
*.woff2 binary
*.exe binary
