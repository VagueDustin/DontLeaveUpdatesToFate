{
  "name": "dont-leave-updates-to-fate",
  "version": "1.4.0",
  "private": true,
  "description": "Scan every package manager on your Windows machine and update what has fallen behind. Provided by VagueDustin Enterprises.",
  "author": {
    "name": "VagueDustin Enterprises",
    "email": "noreply@vaguedustin.com"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/VagueDustin/DontLeaveUpdatesToFate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VagueDustin/DontLeaveUpdatesToFate.git"
  },
  "bugs": {
    "url": "https://github.com/VagueDustin/DontLeaveUpdatesToFate/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:brand": "node scripts/check-brand.mjs",
    "verify": "npm run typecheck && npm run lint:brand && npm run test",
    "icons": "node scripts/build-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:installer": "npm run build && electron-builder --win nsis --publish never",
    "probe": "electron scripts/probe-runtime.mjs",
    "check:glass": "electron scripts/check-glass.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
